# Survey assistant — Groq (https://console.groq.com/keys)
# Without this the assistant still works, using the deterministic lookup in
# src/lib/content/assistant.ts. Set it to get real LLM-backed answers.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Quote form delivery — any webhook URL (Slack, Discord, Zapier, Make, n8n,
# or your own endpoint). Without it, submissions just log to the console.
QUOTE_WEBHOOK_URL=
