# Survey assistant — Groq (https://console.groq.com/keys)
# Without this the assistant still works, using the deterministic lookup in
# src/lib/content/assistant.ts. Set it to get real LLM-backed answers.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Quote form delivery — Resend (https://resend.com/api-keys)
# Without these, submissions just log to the console in dev and fail loudly
# in production rather than silently dropping a lead.
RESEND_API_KEY=
QUOTE_FROM=
# QUOTE_INBOX=
